FROM maven:3.9-eclipse-temurin-21-alpine AS builder

WORKDIR /build

COPY pom.xml ./pom.xml
COPY src ./src
RUN mvn package -DskipTests \
    && cp \
        target/fuelvision-backend-0.0.1-SNAPSHOT.jar \
        /build/application.jar \
    && /opt/java/openjdk/bin/java \
        -Djarmode=tools \
        -jar /build/application.jar \
        extract \
        --layers \
        --destination /build/extracted

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

RUN addgroup -S fuelvision \
    && adduser -S -G fuelvision -u 10001 fuelvision

COPY --from=builder /build/extracted/dependencies/ /app/
COPY --from=builder /build/extracted/spring-boot-loader/ /app/
COPY --from=builder /build/extracted/snapshot-dependencies/ /app/
COPY --from=builder /build/extracted/application/ /app/
COPY docker-entrypoint.vercel.sh /app/docker-entrypoint.vercel.sh

RUN chmod 755 /app/docker-entrypoint.vercel.sh \
    && /opt/java/openjdk/bin/java \
        -XX:+UseSerialGC \
        -XX:ArchiveClassesAtExit=/app/application.jsa \
        -XX:TieredStopAtLevel=1 \
        -Dserver.port=0 \
        -Dspring.context.exit=onRefresh \
        -Dspring.main.lazy-initialization=true \
        -Dspringdoc.api-docs.enabled=false \
        -Dspringdoc.swagger-ui.enabled=false \
        -jar /app/application.jar

USER fuelvision

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=9 \
    CMD wget -q -O - "http://127.0.0.1:${PORT:-80}/actuator/health" \
        | grep -q '"status":"UP"' \
        || exit 1

CMD ["/app/docker-entrypoint.vercel.sh"]
