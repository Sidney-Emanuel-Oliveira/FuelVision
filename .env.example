# Conexão usada pelos scripts do FuelVision
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fuelvision
POSTGRES_USER=fuelvision_app
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_SSLMODE=prefer

# Diretório opcional dos executáveis quando PostgreSQL não está no PATH
POSTGRES_BIN=/opt/homebrew/opt/postgresql@17/bin

# Integração local com o serviço Python de estimativas
FUELVISION_PREDICTION_URL=http://localhost:8000
FUELVISION_MODEL_PATH=ml/artifacts/fuel-price-baseline-v1.joblib
