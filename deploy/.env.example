# Domínio público apontado para o endereço IP do servidor.
FUELVISION_DOMAIN=fuelvision.example.com

# Use senhas longas, diferentes e exclusivas no arquivo deploy/.env ignorado.
POSTGRES_PASSWORD=replace_with_a_strong_application_password
POSTGRES_ADMIN_PASSWORD=replace_with_a_different_admin_password

# Portas públicas usadas pelo Caddy para HTTP, HTTPS e HTTP/3.
FUELVISION_HTTP_PORT=80
FUELVISION_HTTPS_PORT=443
