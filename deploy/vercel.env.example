# Copie para deploy/.env.vercel e substitua somente no arquivo local.
# O arquivo deploy/.env.vercel é ignorado pelo Git.
POSTGRES_HOST=seu-host-postgresql
POSTGRES_PORT=5432
POSTGRES_DB=fuelvision
POSTGRES_USER=seu-usuario
POSTGRES_PASSWORD=substitua-por-uma-senha-real
POSTGRES_SSLMODE=require
POSTGRES_BIN=
